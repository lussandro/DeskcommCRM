# Reduz o contexto de build e — crítico — mantém segredos fora da imagem.
# Sem isto o `next build` carregaria .env.local e embutiria/vazaria segredos.
node_modules
.next
.git
.env
.env.*
test-results
tests
# Dumps do banco que o kit grava ao lado do código (update.sh/backup.sh). Sem esta
# linha o `COPY . .` os leva para DENTRO da imagem: medido em 2026-09-17 numa VPS com
# 2,9 GB de dumps — a imagem do worker foi de 2 GB para 8,5 GB e o build encheu o disco.
backups
.superpowers
playwright.config.ts
*.png
*.log
.lina
docs
tasks
scratchpad
.vercel
# Harness de sessão de IA (skills, hooks, config de CLI): não é código de
# runtime e entrava inteiro na imagem do worker (`COPY . .`).
.claude
.agents
.agent
.codex
.cursor
.opencode
.specs
.changes
